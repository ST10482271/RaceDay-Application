@model RaceDayApplication.Web.Models.PostResults
@{
    ViewData["Title"] = "Post Participant Result";
}

<div class="container my-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white py-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-trophy-fill me-2"></i>Post Participant Result</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="PostResult" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="EnrollmentId" />
                <input type="hidden" asp-for="EventId" />

                <div class="mb-3">
                    <label asp-for="FinishTime" class="form-label fw-semibold">Finish Time (HH:mm:ss)</label>
                    <input asp-for="FinishTime" class="form-control" placeholder="01:45:30" />
                    <span asp-validation-for="FinishTime" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Position" class="form-label fw-semibold">Position</label>
                    <input asp-for="Position" class="form-control" placeholder="e.g. 1" />
                    <span asp-validation-for="Position" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top">
                    <a asp-action="Participants" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-circle me-1"></i> Submit Result
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
