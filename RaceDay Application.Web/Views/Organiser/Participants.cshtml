@model IEnumerable<RaceDayApplication.Web.Models.EventParticipants>

@{
    ViewData["Title"] = "Event Participants";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill me-2"></i>Event Participants</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Name</th>
                            <th>Email</th>
                            <th>Age</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Post Results</th>
                            <th>Change Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">@p.ParticipantName</td>
                                <td class="text-muted">@p.Email</td>
                                <td>@p.Age</td>
                                <td><span class="badge bg-info text-dark">@p.CategoryName</span></td>
                                <td>
                                @if (p.Status == RaceDayApplication.Web.Models.EnrollmentStatus.Accepted)
                                {
                                    <span class="badge bg-success">@p.Status</span>
                                }
                                else if (p.Status == RaceDayApplication.Web.Models.EnrollmentStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">@p.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@p.Status</span>
                                }
                                </td>
                                <td>
                                    <a asp-action="PostResult" asp-route-enrollmentId="@p.EnrollmentId" asp-route-eventId="@ViewBag.EventId" class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-trophy me-1"></i> Post Result
                                    </a>
                                </td>
                                <td>
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        <input type="hidden" name="enrollmentId" value="@p.EnrollmentId" />
                                        <input type="hidden" name="eventId" value="@ViewBag.EventId" />

                                       <select name="status" class="form-select d-inline-block w-auto" onchange="this.form.submit()">
                                          <option value="" disabled selected>Change Status...</option>
                                          <option value="1">Accepted</option>
                                          <option value="0">Pending</option>
                                          <option value="2">Rejected</option>
                                        </select>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i> No participants have registered for this event yet.
        </div>
    }
</div>
