@model RaceDayApplication.Web.Models.CreateEvent

@{
    ViewData["Title"] = "Create New Event";
    var categories = ViewBag.Categories as List<RaceDayApplication.Web.Models.CategoryViewModel> ?? new List<RaceDayApplication.Web.Models.CategoryViewModel>();
}

<div class="container my-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-calendar-plus me-2"></i>Create New Event</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="CreateEvent" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">Event Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. City Marathon 2026" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label fw-semibold">Category</label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">-- Select Category --</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDate" class="form-label fw-semibold">Event Date & Time</label>
                    <input asp-for="EventDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="EventDate" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label fw-semibold">Location</label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. Rosebank Stadium, Gauteng" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-1"></i> Create Event
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
