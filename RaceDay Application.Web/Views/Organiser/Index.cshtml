@model IEnumerable<RaceDayApplication.Web.Models.OrganiserEvents>

@{
    ViewData["Title"] = "Organizer Dashboard";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Organizer Dashboard</h2>
            <p class="text-muted mb-0">Manage your created race events and view participant enrollments.</p>
        </div>
        <a asp-action="CreateEvent" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-circle me-1"></i> Create New Event
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 text-center p-5">
            <div class="card-body">
                <i class="bi bi-calendar-event text-secondary display-1 mb-3"></i>
                <h4>No Events Found</h4>
                <p class="text-muted">You haven't created any race events yet.</p>
                <a asp-action="CreateEvent" class="btn btn-outline-primary">Create Your First Event</a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-white border-bottom-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <span class="badge bg-info text-dark fw-semibold">@item.CategoryName</span>
                            <span class="badge bg-secondary">ID: #@item.Id</span>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-truncate">@item.Name</h5>
                            <p class="card-text text-muted small mb-2">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> @item.Location
                            </p>
                            <p class="card-text text-muted small mb-3">
                                <i class="bi bi-calendar3 me-1"></i> @item.EventDate.ToString("yyyy-MM-dd HH:mm")
                            </p>

                            <div class="p-3 bg-white rounded text-center mb-3">
                                <div class="text-uppercase text-muted fs-7 fw-bold">Total Enrolled</div>
                                <div class="display-6 fw-bold text-primary">@item.EnrollmentCount</div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0 pb-3">
                            <div class="d-grid gap-2">
                                <a asp-action="Participants" asp-route-eventId="@item.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-people-fill me-1"></i> View Participants
                                </a>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm flex-fill">
                                        Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this event?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
