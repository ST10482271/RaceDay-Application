@model IEnumerable<RaceDayApplication.Web.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Available Categories";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🏷️ Available Event Categories</h2>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var category in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 bg-light">
                        <div class="card-body d-flex flex-column">
                            <h4 class="card-title text-primary fw-bold">@category.Name</h4>
                            <p class="card-text text-muted flex-grow-1">
                                @(string.IsNullOrWhiteSpace(category.Description) ? "No description available for this category." : category.Description)
                            </p>
                            <div class="mt-3">
                                <a asp-controller="Events" asp-action="Index" asp-route-categoryName="@category.Name" class="btn btn-outline-primary w-100">
                                    Browse @category.Name Events &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">No categories currently available.</div>
            </div>
        }
    </div>
</div>

